generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. AUTHENTICATION & USER MANAGEMENT
// ==========================================
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("VENDOR")
  createdAt DateTime @default(now())
 
  vendorProfile Vendor?
  reviews       Review[]
  responses     ReviewResponse[]
  flags         ReviewFlag[]
}

model Vendor {
  id                  String    @id @default(uuid())
  userId              String    @unique
  businessName        String
  description         String?   // NEW: Business description
  businessPhone       String?   // NEW: Direct contact number
  businessEmail       String?   // NEW: Official business email
  website             String?   // NEW: Corporate website
  registrationNumber  String?   // NEW: Business license/tax ID
  registeredAddress   String?   // NEW: Legal headquarters address
  profileCompletion   Int       @default(0) // NEW: Completion percentage
  
  verificationStatus  String    @default("UNVERIFIED")
  notificationEnabled Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurants   Restaurant[]
  notifications VendorNotification?
}

// ==========================================
// 2. RESTAURANT MANAGEMENT
// ==========================================
model Restaurant {
  id          String   @id @default(uuid())
  vendorId    String?  // Optional for unclaimed
  name        String
  description String?
  
  // Address split into 3 fields (No lat/long)
  street      String
  city        String
  zipcode     String
  
  phone       String
  email       String
  cuisine     String
  priceLevel  Int
  
  isClaimed   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  vendor          Vendor?                @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  hours           RestaurantHours[]
  tags            RestaurantTag[]
  verifications   BusinessVerification[]
  reviews         Review[]
}

model RestaurantHours {
  id           String     @id @default(uuid())
  restaurantId String
  day          String
  openTime     String
  closeTime    String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

model RestaurantTag {
  id           String     @id @default(uuid())
  restaurantId String
  tagName      String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

model BusinessVerification {
  id           String     @id @default(uuid())
  restaurantId String
  documentUrl  String
  status       String     @default("PENDING")
  submittedAt  DateTime   @default(now())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

model VendorNotification {
  id           String   @id @default(uuid())
  vendorId     String   @unique
  emailAlerts  Boolean  @default(true)
  reviewAlerts Boolean  @default(true)
  vendor       Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
}

// ==========================================
// 3. REVIEW INTERACTION MANAGEMENT
// ==========================================
model Review {
  id           String           @id @default(uuid())
  restaurantId String
  userId       String
  rating       Int
  comment      String           @db.Text
  createdAt    DateTime         @default(now())
 
  restaurant   Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  response     ReviewResponse?
  flags        ReviewFlag[]
}

model ReviewResponse {
  id           String   @id @default(uuid())
  reviewId     String   @unique
  vendorId     String?  
  responseText String   @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
 
  review       Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  vendor       User?    @relation(fields: [vendorId], references: [id], onDelete: SetNull)
}

model ReviewFlag {
  id        String   @id @default(uuid())
  reviewId  String
  vendorId  String?  
  reason    String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
 
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  vendor    User?    @relation(fields: [vendorId], references: [id], onDelete: SetNull)
}